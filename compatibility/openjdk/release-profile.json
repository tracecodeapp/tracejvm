{
  "schema": "tracejvm.openjdk-release-profile.v1",
  "id": "openjdk-23-core-browser-v1",
  "status": "candidate",
  "java": {
    "version": "23.0.2+7",
    "source": "23",
    "target": "23",
    "preview": false,
    "oracle": {
      "distribution": "Eclipse Temurin",
      "repository": "https://github.com/openjdk/jdk23u.git",
      "tag": "jdk-23.0.2+7",
