    "browser capabilities absent from the selected engine"
  ],
  "experimentalProfiles": [
    "server",
    "spring-server"
  ],
  "releaseGate": {
    "manifest": "compatibility/openjdk/manifest.json",
    "crossBrowser": true,
    "requireNoSemanticDefects": true,
    "requireNoUnclassifiedFailures": true
  }
