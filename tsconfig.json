{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@b-jvm/bjvm2": ["engine/bjvm/js/bjvm2.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "compatibility/**/*.ts"]
}
